// Command server is a Forgecell plugin skeleton: a Model Context Protocol server
// on stdio that speaks newline-delimited JSON-RPC 2.0 (initialize,
// notifications/initialized, ping, tools/list and tools/call). It uses only the
// standard library.
//
// tools.json is the contract's tool table and fixture.json holds the describe
// answer; both are embedded. The describe tool answers the fixture, and every
// other tool fails with "not implemented yet". Replace those tools one at a
// time by adding a handler for each to handlers. A handler names why it failed
// with fail: authMissing, rateLimited, network or failed.
//
// Each call runs under its tool's contract timeout (timeoutMs), and its
// structured result is bounded by the tool's contract maxOutputBytes; both
// come from limits. A larger result is never sent, and a call that times out
// is answered with reason failed. A handler that ignores its context and
// outlives its timeout makes every later call fail until it returns.
//
// Every tool first runs accepts on its arguments, which checks exactly three
// things: each top-level required member is present, no unknown top-level
// member is present when additionalProperties is false, and each top-level
// member has the JSON type its schema names. It is not full schema
// validation: it does not check bounds (minLength, maxLength, minimum,
// maximum, maxItems), enums, patterns or formats, and it does not look inside
// nested objects or arrays. A handler you write must check those itself before
// it uses an argument.
//
// Only protocol messages are written to stdout. Nothing is logged, least of all
// a tool's arguments.
package main

import (
	"bufio"
	"bytes"
	"context"
	_ "embed"
	"encoding/json"
	"errors"
	"io"
	"os"
	"strconv"
	"strings"
	"time"
	"unicode/utf8"
)

const (
	serverName      = {{SERVER_NAME}}
	serverVersion   = "0.1.0"
	contractID      = {{CONTRACT_ID}}
	protocolVersion = {{PROTOCOL_VERSION}}
	// maxMessageBytes bounds one incoming message, excluding its newline.
	maxMessageBytes = 1 << 20
	// maxIDBytes bounds a request id that is echoed back.
	maxIDBytes = 256
)

// JSON-RPC 2.0 error codes.
const (
	codeParseError     = -32700
	codeInvalidRequest = -32600
	codeMethodNotFound = -32601
	codeInvalidParams  = -32602
)

// The reasons a failed tool call names: authMissing when a credential the
// plugin needs is unset, expired or refused; rateLimited when the service asks
// the plugin to slow down; network when the service cannot be reached; and
// failed for anything else. The engine reads any other reason as failed.
const (
	authMissing = "auth-missing"
	rateLimited = "rate-limited"
	network     = "network"
	failed      = "failed"
)

// maxFailureBytes bounds the message a failed call sends back.
const maxFailureBytes = 200

// limit is one tool's contract bounds: the most bytes of structured JSON one
// result may hold, and how long one call may run, in milliseconds.
type limit struct {
	tool           string
	maxOutputBytes int
	timeoutMs      int
}

// limits are copied from the contract when the skeleton was made. Every tool
// in tools.json needs one.
var limits = []limit{
{{LIMITS}}
}

// handler answers one tool call whose arguments passed accepts. It returns a
// result that encodes as a JSON object, or an error: return fail(reason,
// message) to name a reason; any other error is answered with reason failed and
// a fixed message. It must stop when ctx ends.
type handler func(ctx context.Context, args map[string]any) (any, error)

// handlers serve the tools you have implemented, by tool name. A tool without
// one answers its fixture when it is the describe tool, and fails with "not
// implemented yet" otherwise.
var handlers = map[string]handler{}

// handlerContext derives one call's context from its timeout; a seam for tests.
var handlerContext = context.WithTimeout

//go:embed tools.json
var toolsJSON []byte

//go:embed fixture.json
var fixtureJSON []byte

// inputSchema is the part of a contract input schema the server checks: the
// required properties, whether unknown members are refused, and the JSON type
// of each top-level property.
type inputSchema struct {
	Type       string `json:"type"`
	Properties map[string]struct {
		Type any `json:"type"`
	} `json:"properties"`
	Required             []string        `json:"required"`
	AdditionalProperties json.RawMessage `json:"additionalProperties"`
}

type tool struct {
	Name        string          `json:"name"`
	Access      string          `json:"access"`
	InputSchema json.RawMessage `json:"inputSchema"`
	schema      inputSchema
	maxOutput   int
	timeout     time.Duration
}

type server struct {
	tools    []tool
	byName   map[string]int
	fixtures map[string]json.RawMessage

	// running is closed when the last handler returns; nil when none ran.
	running chan struct{}
}

func main() {
	s, err := load()
	if err != nil {
		io.WriteString(os.Stderr, serverName+": the embedded tool table or fixture is invalid\n")
		os.Exit(1)
	}
	if err := s.serve(os.Stdin, os.Stdout); err != nil {
		io.WriteString(os.Stderr, serverName+": "+err.Error()+"\n")
		os.Exit(1)
	}
}

// load reads the embedded tool table and fixtures, and attaches each tool's
// limits. A tool without limits, or a handler for a tool that is not listed, is
// refused.
func load() (*server, error) {
	var table struct {
		Tools []tool `json:"tools"`
	}
	if err := json.Unmarshal(toolsJSON, &table); err != nil {
		return nil, err
	}
	bounds := map[string]limit{}
	for _, l := range limits {
		if l.maxOutputBytes < 1 || l.timeoutMs < 1 {
			return nil, errors.New("a tool's limits are not positive")
		}
		bounds[l.tool] = l
	}
	s := &server{byName: map[string]int{}}
	if err := json.Unmarshal(fixtureJSON, &s.fixtures); err != nil {
		return nil, err
	}
	for name, raw := range s.fixtures {
		var compact bytes.Buffer
		if err := json.Compact(&compact, raw); err != nil {
			return nil, err
		}
		s.fixtures[name] = compact.Bytes()
	}
	for i, t := range table.Tools {
		if err := json.Unmarshal(t.InputSchema, &t.schema); err != nil || t.schema.Type != "object" {
			return nil, errors.New("a tool's input schema is not an object schema")
		}
		var compact bytes.Buffer
		if err := json.Compact(&compact, t.InputSchema); err != nil {
			return nil, err
		}
		t.InputSchema = compact.Bytes()
		l, ok := bounds[t.Name]
		if !ok {
			return nil, errors.New("a tool has no limits")
		}
		t.maxOutput, t.timeout = l.maxOutputBytes, time.Duration(l.timeoutMs)*time.Millisecond
		s.tools = append(s.tools, t)
		s.byName[t.Name] = i
	}
	for name := range handlers {
		if _, ok := s.byName[name]; !ok {
			return nil, errors.New("a handler serves a tool that is not listed")
		}
	}
	return s, nil
}

// serve answers requests from in on out, one at a time, until in ends.
func (s *server) serve(in io.Reader, out io.Writer) error {
	r := bufio.NewReaderSize(in, 64<<10)
	for {
		line, tooLarge, err := readLine(r, maxMessageBytes)
		if errors.Is(err, io.EOF) {
			return nil
		}
		if err != nil {
			return errors.New("reading a request failed")
		}
		var reply map[string]any
		if tooLarge {
			reply = errorMessage(nil, codeInvalidRequest, "the message exceeds the size bound")
		} else {
			reply = s.handle(line)
		}
		if reply == nil {
			continue
		}
		raw, err := json.Marshal(reply)
		if err != nil {
			return errors.New("encoding a response failed")
		}
		if _, err := out.Write(append(raw, '\n')); err != nil {
			return errors.New("writing a response failed")
		}
	}
}

// readLine returns one message of at most limit bytes, without its newline (and
// an optional carriage return). A longer message is drained to its newline
// without being kept and reported as tooLarge. A message cut off by the end of
// input is dropped.
func readLine(r *bufio.Reader, limit int) (line []byte, tooLarge bool, err error) {
	var buf []byte
	size := 0
	for {
		chunk, err := r.ReadSlice('\n')
		n := len(chunk)
		if err == nil {
			n--
		}
		size += n
		if size > limit {
			tooLarge, buf = true, nil
		}
		if !tooLarge {
			buf = append(buf, chunk...)
		}
		switch {
		case err == nil:
			if tooLarge {
				return nil, true, nil
			}
			buf = buf[:len(buf)-1]
			if n := len(buf); n > 0 && buf[n-1] == '\r' {
				buf = buf[:n-1]
			}
			return buf, false, nil
		case errors.Is(err, bufio.ErrBufferFull):
			continue
		default:
			return nil, false, err
		}
	}
}

// handle answers one message; nil means no reply. The raw line must be valid
// UTF-8 JSON, so only JSON whitespace may surround the object: a line that
// starts with any other space, such as U+00A0 or U+0085, is a parse error.
func (s *server) handle(line []byte) map[string]any {
	trimmed := bytes.TrimSpace(line)
	if len(trimmed) == 0 {
		return nil
	}
	if !utf8.Valid(line) || !json.Valid(line) {
		return errorMessage(nil, codeParseError, "parse error")
	}
	if trimmed[0] != '{' || !uniqueKeys(trimmed) {
		return errorMessage(nil, codeInvalidRequest, "invalid request")
	}
	var members map[string]json.RawMessage
	if err := json.Unmarshal(trimmed, &members); err != nil {
		return errorMessage(nil, codeParseError, "parse error")
	}
	var id json.RawMessage
	if raw, ok := members["id"]; ok && string(raw) != "null" {
		if id = validID(raw); id == nil {
			return errorMessage(nil, codeInvalidRequest, "invalid request")
		}
	}
	var version, method string
	if json.Unmarshal(members["jsonrpc"], &version) != nil || version != "2.0" {
		return errorMessage(id, codeInvalidRequest, "invalid request")
	}
	if json.Unmarshal(members["method"], &method) != nil || method == "" {
		return errorMessage(id, codeInvalidRequest, "invalid request")
	}
	if id == nil {
		// A notification, such as notifications/initialized, gets no reply.
		return nil
	}
	params, ok := object(members["params"])
	if !ok {
		return errorMessage(id, codeInvalidParams, "params is not an object")
	}
	switch method {
	case "initialize":
		return resultMessage(id, map[string]any{
			"protocolVersion": protocolVersion,
			"capabilities": map[string]any{
				"tools":        map[string]any{},
				"experimental": map[string]any{"forgecell": map[string]any{"contract": contractID}},
			},
			"serverInfo": map[string]any{"name": serverName, "version": serverVersion},
		})
	case "ping":
		return resultMessage(id, map[string]any{})
	case "tools/list":
		tools := make([]map[string]any, 0, len(s.tools))
		for _, t := range s.tools {
			tools = append(tools, map[string]any{"name": t.Name, "inputSchema": t.InputSchema})
		}
		return resultMessage(id, map[string]any{"tools": tools})
	case "tools/call":
		return s.call(id, params)
	}
	return errorMessage(id, codeMethodNotFound, "method not found")
}

// call checks a tools/call request and its arguments, then runs the tool.
func (s *server) call(id json.RawMessage, params map[string]json.RawMessage) map[string]any {
	var name string
	if json.Unmarshal(params["name"], &name) != nil {
		return errorMessage(id, codeInvalidParams, "the tool name is invalid")
	}
	index, ok := s.byName[name]
	if !ok {
		return errorMessage(id, codeInvalidParams, "unknown tool")
	}
	t := s.tools[index]
	raw := params["arguments"]
	if raw == nil || string(bytes.TrimSpace(raw)) == "null" {
		raw = json.RawMessage("{}")
	}
	if _, ok := object(raw); !ok {
		return errorMessage(id, codeInvalidParams, "arguments is not an object")
	}
	dec := json.NewDecoder(bytes.NewReader(raw))
	dec.UseNumber()
	var args map[string]any
	if err := dec.Decode(&args); err != nil || !t.schema.accepts(args) {
		return resultMessage(id, failure(failed, "the arguments do not match the input schema"))
	}
	return resultMessage(id, s.run(t, args))
}

// unimplemented serves a tool that has no handler: the describe tool answers
// its fixture, and any other tool fails with "not implemented yet".
func (s *server) unimplemented(t tool) handler {
	return func(context.Context, map[string]any) (any, error) {
		if strings.HasSuffix(t.Name, "_describe") {
			if describe, ok := s.fixtures[t.Name]; ok {
				return describe, nil
			}
		}
		return nil, fail(failed, "not implemented yet: "+t.Name)
	}
}

type outcome struct {
	result any
	err    error
}

// run calls the tool's handler under its timeout and renders the result. The
// result must encode as a JSON object within the tool's output bound, or the
// call fails with reason failed and nothing of it is sent. A handler that
// ignores its context and outlives its timeout keeps the server from starting
// another until it returns: later calls fail meanwhile, so handlers never
// overlap.
func (s *server) run(t tool, args map[string]any) map[string]any {
	if s.running != nil {
		select {
		case <-s.running:
		default:
			return failure(failed, "an earlier call is still running")
		}
	}
	h := handlers[t.Name]
	if h == nil {
		h = s.unimplemented(t)
	}
	ctx, cancel := handlerContext(context.Background(), t.timeout)
	defer cancel()
	done := make(chan outcome, 1)
	running := make(chan struct{})
	s.running = running
	// The handler is marked finished before its outcome is sent, so once run
	// receives the outcome a later call never finds it still running.
	go func() {
		var o outcome
		defer func() {
			if recover() != nil {
				o = outcome{err: errors.New("the handler panicked")}
			}
			close(running)
			done <- o
		}()
		result, err := h(ctx, args)
		o = outcome{result, err}
	}()
	var o outcome
	select {
	case o = <-done:
	case <-ctx.Done():
	}
	if ctx.Err() != nil {
		return failure(failed, "the call timed out")
	}
	if o.err != nil {
		var e *toolError
		if errors.As(o.err, &e) {
			return failure(e.reason, e.message)
		}
		return failure(failed, "the tool failed")
	}
	structured, err := json.Marshal(o.result)
	if _, ok := object(structured); err != nil || !ok {
		return failure(failed, "the tool returned no JSON object")
	}
	if len(structured) > t.maxOutput {
		return failure(failed, "the result exceeds the tool's output bound")
	}
	return map[string]any{
		"content":           []any{map[string]any{"type": "text", "text": string(structured)}},
		"structuredContent": json.RawMessage(structured),
	}
}

// accepts checks the top-level required members, unknown top-level members
// when additionalProperties is false, and the JSON type of each top-level
// member, and nothing else: bounds, enums, patterns and nested values are the
// handler's to check.
func (s inputSchema) accepts(args map[string]any) bool {
	for _, name := range s.Required {
		if _, ok := args[name]; !ok {
			return false
		}
	}
	closed := string(bytes.TrimSpace(s.AdditionalProperties)) == "false"
	for key, value := range args {
		p, ok := s.Properties[key]
		if !ok {
			if closed {
				return false
			}
			continue
		}
		if p.Type != nil && !typeAllows(p.Type, jsonType(value)) {
			return false
		}
	}
	return true
}

// typeAllows reports whether a schema type (a string or a list of strings)
// accepts a value of JSON type got. A number accepts integers.
func typeAllows(schemaType any, got string) bool {
	ok := func(t any) bool { return t == got || (t == "number" && got == "integer") }
	switch t := schemaType.(type) {
	case string:
		return ok(t)
	case []any:
		for _, item := range t {
			if ok(item) {
				return true
			}
		}
	}
	return false
}

func jsonType(v any) string {
	switch n := v.(type) {
	case nil:
		return "null"
	case bool:
		return "boolean"
	case string:
		return "string"
	case json.Number:
		if _, err := strconv.ParseInt(string(n), 10, 64); err == nil {
			return "integer"
		}
		return "number"
	case []any:
		return "array"
	case map[string]any:
		return "object"
	}
	return ""
}

// toolError is a handler failure with a fixed reason and message.
type toolError struct {
	reason, message string
}

func (e *toolError) Error() string { return e.reason + ": " + e.message }

// fail returns a handler error that names reason: authMissing, rateLimited or
// network; any other reason becomes failed. Keep message short, fixed and free
// of secrets and local paths. Forgecell shows only the reason.
func fail(reason, message string) error {
	return &toolError{reason: knownReason(reason), message: message}
}

// knownReason returns reason when it is one the engine reads, and failed
// otherwise.
func knownReason(reason string) string {
	switch reason {
	case authMissing, rateLimited, network:
		return reason
	}
	return failed
}

// failure is an isError tool result with a known reason and a message cut to
// maxFailureBytes.
func failure(reason, message string) map[string]any {
	reason = knownReason(reason)
	message = strings.ToValidUTF8(message, "")
	if len(message) > maxFailureBytes {
		n := maxFailureBytes
		for n > 0 && !utf8.RuneStart(message[n]) {
			n--
		}
		message = message[:n]
	}
	return map[string]any{
		"isError":           true,
		"content":           []any{map[string]any{"type": "text", "text": message}},
		"structuredContent": map[string]any{"reason": reason, "message": message},
	}
}

// uniqueKeys reports whether no object in raw repeats a key, so a repeated
// "id", "method" or argument is never read two ways.
func uniqueKeys(raw []byte) bool {
	d := json.NewDecoder(bytes.NewReader(raw))
	var walk func() bool
	walk = func() bool {
		tok, err := d.Token()
		if err != nil {
			return false
		}
		delim, ok := tok.(json.Delim)
		if !ok {
			return true
		}
		seen := map[string]bool{}
		for d.More() {
			if delim == '{' {
				key, err := d.Token()
				if err != nil {
					return false
				}
				k, _ := key.(string)
				if seen[k] {
					return false
				}
				seen[k] = true
			}
			if !walk() {
				return false
			}
		}
		_, err = d.Token()
		return err == nil
	}
	return walk()
}

// validID returns id when it is a JSON string or integer of bounded size, and
// nil otherwise.
func validID(id json.RawMessage) json.RawMessage {
	if len(id) == 0 || len(id) > maxIDBytes {
		return nil
	}
	var s string
	if json.Unmarshal(id, &s) == nil {
		return id
	}
	if _, err := strconv.ParseInt(string(id), 10, 64); err == nil {
		return id
	}
	return nil
}

// object decodes a JSON object into its members. Absent params are an empty
// object.
func object(raw json.RawMessage) (map[string]json.RawMessage, bool) {
	if raw == nil {
		return map[string]json.RawMessage{}, true
	}
	trimmed := bytes.TrimSpace(raw)
	if len(trimmed) == 0 || trimmed[0] != '{' {
		return nil, false
	}
	var members map[string]json.RawMessage
	if err := json.Unmarshal(trimmed, &members); err != nil {
		return nil, false
	}
	return members, true
}

func nullID(id json.RawMessage) json.RawMessage {
	if id == nil {
		return json.RawMessage("null")
	}
	return id
}

func resultMessage(id json.RawMessage, result any) map[string]any {
	return map[string]any{"jsonrpc": "2.0", "id": nullID(id), "result": result}
}

func errorMessage(id json.RawMessage, code int, message string) map[string]any {
	return map[string]any{"jsonrpc": "2.0", "id": nullID(id), "error": map[string]any{"code": code, "message": message}}
}
